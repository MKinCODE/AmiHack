# CityPulse Frontend Environment Configuration
# When deploying to Vercel, set VITE_BACKEND_URL to your Render backend URL:
# Example: https://citypulse-backend.onrender.com
#
# During local development, you can leave it blank to use the Vite proxy.
VITE_BACKEND_URL=https://your-citypulse-backend.onrender.com
